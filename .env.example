# ========================================================
# KICK DISCORD BOT - YAPILANDIRMA DOSYASI
# ========================================================

# 1. DISCORD BOT AYARLARI (ZORUNLU)
# https://discord.com/developers/applications adresinden alınır:
DISCORD_TOKEN="BURAYA_DISCORD_BOT_TOKENI_GIRIN"
DISCORD_CLIENT_ID="BURAYA_APPLICATION_ID_GIRIN"

# 2. VERİTABANI VE SUNUCU AYARLARI (DEĞİŞTİRMEYE GEREK YOKTUR)
PORT=3000
HOST="0.0.0.0"
DATABASE_URL="file:./dev.db"

# 3. İSTEĞE BAĞLI: REDIS (Yoksa otomatik dahili bellek kuyruğu çalışır)
# REDIS_URL="redis://localhost:6379"

# 4. KICK GELİŞTİRİCİ AYARLARI (/hesap-bagla, Abone & VIP Rol Eşleme İçin)
# https://kick.com/settings/developer adresinden "Create Application" yapın.
# Redirect URI alanına: http://localhost:3000/api/auth/kick/callback yazın.
KICK_CLIENT_ID="BURAYA_KICK_CLIENT_ID_GIRIN"
KICK_CLIENT_SECRET="BURAYA_KICK_CLIENT_SECRET_GIRIN"
KICK_REDIRECT_URI="http://localhost:3000/api/auth/kick/callback"
